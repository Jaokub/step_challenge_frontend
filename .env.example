# Step Challenge Mobile App — environment template
#
# Copy to `.env` and fill in real values. `.env` itself is gitignored;
# this file is the tracked template, so keep it free of real secrets.
#
#   cp .env.example .env

# Backend API base URL.
# Deployed:   https://step-challenge-backend.vercel.app/api/v1
# Local dev:  http://localhost:3000/api/v1
# Android device on the same LAN needs your computer's IP, not localhost —
# e.g. http://192.168.1.5:3000/api/v1
EXPO_PUBLIC_API_URL=https://step-challenge-backend.vercel.app/api/v1

# Google Sign-In — the **Web** client ID from Google Cloud Console (yes, Web,
# even on Android: it's passed as GoogleSignin.configure({ webClientId }) so
# the app can request an ID token the backend is able to verify).
# The Android OAuth client is also required in the Console — it needs the EAS
# build's SHA-1 — but its ID is not referenced here.
# Changing this requires a new EAS dev-client build to take effect.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
