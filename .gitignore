# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# Broadened from `.env*.local` + a bare `.env` further down: neither covered
# .env.production / .env.development, which is where EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
# and friends would end up. Keep .env.example tracked as the template.
.env*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# ── Google Sign-In config (BUILD_PLAN Phase 9, Task 5) ──────────────────
# These are generated in the Google Cloud Console and carry the OAuth client
# IDs for this app. They were NOT ignored before, so they'd have been picked
# up by `git add .` the moment they landed in the project.
google-services.json
GoogleService-Info.plist

# ── EAS / Android signing ───────────────────────────────────────────────
# `credentials.json` holds the keystore path AND its password; a leaked
# release keystore means someone else can sign builds as this app, and it
# cannot be rotated for an already-published app. `*.jks` was already
# covered above but `.keystore` — the more common extension — was not.
credentials.json
*.keystore
# Note: eas.json is intentionally NOT ignored. It's build configuration and
# belongs in the repo; secrets go in EAS environment variables instead.

# Expo
.expo-shared/

# npm auth tokens
.npmrc

# Machine-local config overrides
app.config.local.*

# Editor directories and files
.vscode/
.idea/
*.swp

# Testing
coverage/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx

# Logs
*.log
